{
  "name": "beta-life",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop board for arranging habits around the rhythm of a day.",
  "author": "Dylan Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen-junluo/beta-life.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc --noEmit && vite build",
    "build:mac": "tauri build --bundles dmg",
    "build:windows": "tauri build --bundles nsis,msi",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "tauri": "tauri",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "2.9.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
