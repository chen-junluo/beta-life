  {
    "name": "add_memory",
    "panel": "memories",
    "access": "write",
    "description": "Stage a new memory. date is YYYYMMDD when the day is known, otherwise YYYYQn (e.g. 2021Q2). stage must be one of the life stage names or omitted. Keep the user's own words in content. The result returns the new id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "song": {
          "type": "string",
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "stage": {
          "type": "string",
          "maxLength": 60
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "emotion": {
          "type": "string",
          "enum": [
            "nostalgic",
            "melancholic",
            "excited",
            "calm",
            "confused",
            "warm"
          ]
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "content",
        "date",
        "emotion",
        "intensity"
      ],
      "additionalProperties": false
    }
  },
