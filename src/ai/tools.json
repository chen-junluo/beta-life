[
  {
    "name": "list_boards",
    "panel": "board",
    "access": "read",
    "description": "List all boards with their ids, names and habit counts, and which one is active. Habit tools only work on the active board.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_habits",
    "panel": "board",
    "access": "read",
    "description": "List every habit on the active board with id, title, tags, description, placement (period or hour), position inside that placement, and today's done state. Returns confirmed data only; staged changes are not included.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "add_habit",
    "panel": "board",
    "access": "write",
    "description": "Stage a new habit on the active board. Give exactly one of period or hour. Use period unless the user states an exact hour. The result returns the new habit id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "One concise action."
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Optional Markdown note."
        },
        "tags": {
          "type": "string",
          "maxLength": 200,
          "description": "Comma-separated tags, e.g. \"运动, 每天\"."
        },
        "period": {
          "type": "string",
          "enum": [
            "morning",
            "noon",
            "evening",
            "sleep"
          ]
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based slot inside the target placement; omit to put it first."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_habit",
    "panel": "board",
    "access": "write",
    "description": "Stage edits to a habit's title, description or tags. Only the given fields change. Use move_habit to change its time.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "tags": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_habit",
    "panel": "board",
    "access": "write",
    "description": "Stage moving a habit to another period or hour, or to another position in the same one. Give exactly one of period or hour.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "enum": [
            "morning",
            "noon",
            "evening",
            "sleep"
          ]
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based slot inside the target placement; omit to put it last."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_habit",
    "panel": "board",
    "access": "write",
    "description": "Stage deleting a habit. Only use when the user clearly asks to remove it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_habit_done",
    "panel": "board",
    "access": "write",
    "description": "Stage checking or unchecking a habit as done today.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "done"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_nodes",
    "panel": "forest",
    "access": "read",
    "description": "List every node of one ability map as a tree: id, name, level (0 = 领域, 1 = 能力组, 2 = 能力), parentId, order among siblings, and whether it has a note.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        }
      },
      "required": [
        "map"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_node",
    "panel": "forest",
    "access": "read",
    "description": "Read the Markdown notes of one or more nodes in one call.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "One or more ids; read everything you need in one call."
        }
      },
      "required": [
        "map",
        "ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_node",
    "panel": "forest",
    "access": "write",
    "description": "Stage a new node. Without parentId it becomes a top-level 领域 (level 0); under a level-0 node it is a 能力组; under a level-1 node it is a 能力. Level-2 nodes cannot have children. The result returns the new node id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "markdown": {
          "type": "string",
          "maxLength": 8000,
          "description": "Optional Markdown note."
        }
      },
      "required": [
        "map",
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_node",
    "panel": "forest",
    "access": "write",
    "description": "Stage edits to a node's name, Markdown note, or color (color only applies to level-0 nodes).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "markdown": {
          "type": "string",
          "maxLength": 8000
        },
        "color": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "description": "Hex color like #7FB77E."
        }
      },
      "required": [
        "map",
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_node",
    "panel": "forest",
    "access": "write",
    "description": "Stage moving a node (with its subtree) under another parent, or to the top level with parentId \"\". position is the 0-based slot among the new siblings; omit to put it last. The tree is at most three levels deep.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": "string",
          "description": "Target parent id, or \"\" for the top level."
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "map",
        "id",
        "parentId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_node",
    "panel": "forest",
    "access": "write",
    "description": "Stage deleting a node together with all of its descendants. Only use when the user clearly asks to remove it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "enum": [
            "vision",
            "research"
          ],
          "description": "vision = Long-term Vision map, research = Research Agenda map."
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "map",
        "id"
      ],
      "additionalProperties": false
    }
  },
