        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        "tags": {
          "type": "string",
          "maxLength": 200,
          "description": "Hierarchical tag path separated by /, e.g. \"社会学/组织理论\"."
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 500
        },
        "sourceNote": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "title",
        "markdown"
      ],
      "additionalProperties": false
    }
  },
